{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "semester-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MODEL": "qwen/qwen3.8-27b",
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": ""
  }
}
